      "refKeys": [],
      "branchKeys": ["blockSave", "caseSensitive", "message", "references", "i18n"],
      "clientKeys": ["blockSave", "when", "whenAst", "caseSensitive", "message", "deferred", "deferredWhy", "snapshotFields", "i18n"],
      "textKeys": ["message"],
      "needs": [],
      "dialog": true,
      "js": {"factories": {"required": "QRIDRequiredInit"}},
      "scan": {"issueLabels": {"*": "Missing value"}}
    },
    {
