        },
        "dialogWhy": "a Required rule supports Text, Notes, dropdown, radio, yes/no, true/false, SQL and slider fields (not calc — the person entering data cannot fill it)"
      },
      "hooks": {},
      "evaluator": "findingsRequired",
      "missingCodes": "answer",
