{
  "_comment": [
    "The validation modes this module knows, one entry per action tag. This file is the single source:",
    "php/ModeRegistry.php reads it for the server, and tests/gen_mode_registry.cjs writes the browser's copy",
    "into js/engine.js (CI fails when that copy is stale). Adding a mode means adding an entry here plus the",
    "methods it names; tests/registry_php.php lists the hand-written places that must also name the new tag.",
    "Order matters: tags are read in this order, and branchKeys/clientKeys are unions in this order.",
    "refKeys kinds: cond = a condition string (role gate = decides whether the rule applies, role test =",
    "the verdict itself); fieldList = a list of field names the rule reads; operand = one field reference whose",
    "value the verdict reads (op = the key the browser gets the folded operand under, value = the key the",
    "server's extended compile writes the resolved value to).",
    "serverKeys (optional): keys the server needs and the page must not carry; they are removed from every",
    "rule and branch before the page config is written (ModeRegistry::clientShape)."
  ],
  "common": {
    "refKeys": [
      {"key": "when", "kind": "cond", "role": "gate", "ast": "whenAst"}
    ]
  },
  "modes": [
    {
      "mode": "check",
      "tag": "@UVALIDATE",
      "types": ["single", "pooled"],
      "defaultType": "single",
      "parser": "parseValue",
      "checker": null,
      "hasAlgorithm": true,
      "eligibility": {
        "fieldTypes": ["text", "notes"],
        "annotationWhy": "this tag only works on Text or Notes fields (this field is \"{type}\").",
        "dialogWhy": "only Text and Notes fields can be validated"
      },
      "hooks": {},
      "evaluator": "findingsCheck",
      "missingCodes": "skip",
      "refKeys": [],
      "branchKeys": ["algorithm", "idPattern", "alternates", "source", "strip", "keepChars",
                     "idLengths", "idMinLen", "idMaxLen", "expectedIds",
                     "blockSave", "suggestFix", "note"],
      "clientKeys": ["algorithm", "idPattern", "alternates", "source", "strip", "suggestFix",
                     "keepChars", "idLengths", "idMinLen", "idMaxLen", "expectedIds",
                     "blockSave", "when", "whenAst"],
      "needs": [],
      "dialog": true,
      "js": {"factories": {"single": "QRIDSingleInit", "pooled": "QRIDPooledInit"}},
      "scan": {"issueLabels": {"*": "Wrong value"}}
    },
    {
      "mode": "constraint",
      "tag": "@UVASSERT",
      "types": ["constraint"],
      "defaultType": "constraint",
      "parser": "parseAssertValue",
      "checker": "checkConstraint",
      "hasAlgorithm": false,
      "eligibility": {
        "fieldTypes": ["text", "notes", "dropdown", "radio", "yesno", "truefalse", "calc", "sql", "slider"],
        "annotationWhy": "@UVASSERT does not support \"{type}\" fields — it checks one scalar field's value against a condition.",
        "dialogWhy": "a Constraint rule supports Text, Notes, dropdown, radio, yes/no, true/false, calc and slider fields"
      },
      "hooks": {},
      "evaluator": "findingsConstraint",
      "missingCodes": "skip",
      "refKeys": [
        {"key": "assert", "kind": "cond", "role": "test", "ast": "assertAst"}
      ],
      "branchKeys": ["assert", "caseSensitive", "message", "references"],
      "clientKeys": ["assert", "assertAst", "caseSensitive", "message", "deferred", "deferredWhy", "snapshotFields"],
      "needs": [],
      "dialog": true,
      "js": {"factories": {"constraint": "QRIDConstraintInit"}},
      "scan": {"issueLabels": {"*": "Wrong value"}}
    },
    {
      "mode": "required",
      "tag": "@UVREQUIRED",
      "types": ["required"],
      "defaultType": "required",
      "parser": "parseRequiredValue",
      "checker": "checkRequired",
      "hasAlgorithm": false,
      "eligibility": {
        "fieldTypes": ["text", "notes", "dropdown", "radio", "yesno", "truefalse", "sql", "slider"],
        "annotationWhy": "@UVREQUIRED does not support \"{type}\" fields — it requires a scalar input the person can fill in.",
        "annotationWhyFor": {
          "calc": "@UVREQUIRED does not support \"calc\" fields — a calc value is computed, the person entering data cannot fill it in."
        },
        "dialogWhy": "a Required rule supports Text, Notes, dropdown, radio, yes/no, true/false and slider fields (not calc — the person entering data cannot fill it)"
      },
      "hooks": {},
      "evaluator": "findingsRequired",
      "missingCodes": "answer",
      "refKeys": [],
      "branchKeys": ["blockSave", "caseSensitive", "message", "references"],
      "clientKeys": ["blockSave", "when", "whenAst", "caseSensitive", "message", "deferred", "deferredWhy", "snapshotFields"],
      "needs": [],
      "dialog": true,
      "js": {"factories": {"required": "QRIDRequiredInit"}},
      "scan": {"issueLabels": {"*": "Missing value"}}
    },
    {
      "mode": "unique",
      "tag": "@UVUNIQUE",
      "types": ["unique"],
      "defaultType": "unique",
      "parser": "parseUniqueValue",
      "checker": "checkUnique",
      "hasAlgorithm": false,
      "eligibility": {
        "fieldTypes": ["text", "notes", "dropdown", "radio", "yesno", "truefalse", "sql", "slider"],
        "annotationWhy": "@UVUNIQUE does not support \"{type}\" fields — it compares one scalar field's value across records.",
        "dialogWhy": "a Unique rule supports Text, Notes, dropdown, radio, yes/no, true/false and slider fields (not calc — the person entering data cannot fix a calc collision)"
      },
      "hooks": {"field": "annotateUniqueField", "dictionary": "annotateUniqueDictionary"},
      "evaluator": "findingsUnique",
      "missingCodes": "skip",
      "refKeys": [
        {"key": "uniqueWith", "kind": "fieldList", "role": "test"}
      ],
      "branchKeys": ["uniqueWith", "uniqueScope", "uniqueSurveys"],
      "clientKeys": ["uniqueWith", "uniqueScope", "uniqueSurveys", "uniqueRecordAsts"],
      "needs": ["transport"],
      "dialog": true,
      "js": {"factories": {"unique": "QRIDUniqueInit"}},
      "scan": {"issueLabels": {"*": "Duplicate value"}}
    },
    {
      "mode": "choices",
      "tag": "@UVCHOICES",
      "types": ["choices"],
      "defaultType": "choices",
      "parser": "parseChoicesValue",
      "checker": "checkChoices",
      "hasAlgorithm": false,
      "eligibility": {
        "fieldTypes": ["radio", "dropdown", "checkbox"],
        "annotationWhy": "@UVCHOICES does not support \"{type}\" fields — it filters the options of a radio, dropdown or checkbox field.",
        "dialogWhy": "a Choices rule supports radio, dropdown and checkbox fields"
      },
      "hooks": {"field": "annotateChoicesField", "dictionary": "annotateChoicesDictionary"},
      "evaluator": "findingsChoices",
      "missingCodes": "skip",
      "refKeys": [],
      "branchKeys": ["choicesShow", "choicesHide", "choicesAll"],
      "clientKeys": ["choicesShow", "choicesHide", "choicesAll"],
      "needs": [],
      "dialog": false,
      "js": {"factories": {"choices": "QRIDChoiceFilterInit"}},
      "scan": {"issueLabels": {"*": "No longer an allowed choice"}}
    },
    {
      "mode": "window",
      "tag": "@UVWINDOW",
      "types": ["window"],
      "defaultType": "window",
      "parser": "parseWindowValue",
      "checker": "checkWindow",
      "hasAlgorithm": false,
      "eligibility": {
        "fieldTypes": ["text"],
        "annotationWhy": "@UVWINDOW does not support \"{type}\" fields — it checks a date typed into a Text field with date or datetime validation.",
        "dialogWhy": "a Window rule supports Text fields with date or datetime validation"
      },
      "hooks": {"field": "annotateWindowField", "dictionary": "annotateWindowDictionary"},
      "evaluator": "findingsWindow",
      "missingCodes": "skip",
      "refKeys": [
        {"key": "windowFrom", "kind": "operand", "role": "test", "op": "windowFromOp", "value": "windowFromValue"}
      ],
      "branchKeys": ["windowFrom", "windowLo", "windowHi", "windowUnit", "windowNotFuture",
                     "dateType", "dateFormat", "fromType", "fromFormat"],
      "clientKeys": ["windowFrom", "windowFromOp", "windowLo", "windowHi", "windowUnit", "windowNotFuture",
                     "dateType", "dateFormat", "fromType", "fromFormat",
                     "blockSave", "when", "whenAst", "caseSensitive", "message", "deferred", "deferredWhy", "snapshotFields"],
      "needs": ["clock"],
      "dialog": false,
      "js": {"factories": {"window": "QRIDWindowInit"}},
      "scan": {"issueLabels": {"future": "Date in the future", "*": "Date outside allowed window"},
               "detailKeys": ["windowFrom", "windowLo", "windowHi", "windowUnit"]}
    },
    {
      "mode": "exists",
      "tag": "@UVEXISTS",
      "types": ["exists"],
      "defaultType": "exists",
      "parser": "parseExistsValue",
      "checker": "checkExists",
      "hasAlgorithm": false,
      "eligibility": {
        "fieldTypes": ["text", "dropdown", "radio", "sql"],
        "annotationWhy": "@UVEXISTS does not support \"{type}\" fields — it looks up one typed or chosen value among saved records.",
        "dialogWhy": "an Exists rule supports Text, dropdown, radio and SQL fields"
      },
      "hooks": {"field": "annotateExistsField", "dictionary": "annotateExistsDictionary"},
      "evaluator": "findingsExists",
      "missingCodes": "skip",
      "refKeys": [
        {"key": "existsLocal", "kind": "fieldList", "role": "test"},
        {"key": "existsTargets", "kind": "fieldList", "role": "lookup"}
      ],
      "branchKeys": ["existsIn", "existsEvent", "existsScope", "existsMatch", "existsSurveys", "existsLocal",
                     "existsTargets", "existsProject", "existsPid", "existsRemoteTargets"],
      "clientKeys": ["existsLocal", "existsSurveys",
                     "blockSave", "when", "whenAst", "caseSensitive", "message", "deferred", "deferredWhy", "snapshotFields"],
      "serverKeys": ["existsIn", "existsEvent", "existsScope", "existsMatch", "existsTargets",
                     "existsProject", "existsPid", "existsRemoteTargets"],
      "needs": ["transport"],
      "dialog": false,
      "js": {"factories": {"exists": "QRIDExistsInit"}},
      "scan": {"issueLabels": {"*": "Not found in its source"}}
    },
    {
      "mode": "range",
      "tag": "@UVRANGE",
      "types": ["range"],
      "defaultType": "range",
      "parser": "parseRangeValue",
      "checker": "checkRange",
      "hasAlgorithm": false,
      "eligibility": {
        "fieldTypes": ["text", "calc", "slider"],
        "textValidations": "^(?:|int|integer|float|number(?:_[1-9]dp)?(?:_comma_decimal)?)$",
        "annotationWhy": "@UVRANGE does not support \"{type}\" fields — it checks a number typed into a Text field, a calc or a slider.",
        "dialogWhy": "a Range rule supports number Text fields, calc fields and sliders"
      },
      "hooks": {"field": "annotateRangeField", "dictionary": "annotateRangeDictionary"},
      "evaluator": "findingsRange",
      "missingCodes": "skip",
      "refKeys": [
        {"key": "rangeSex", "kind": "operand", "role": "test", "op": "rangeSexOp", "value": "rangeSexValue"},
        {"key": "rangeAgeDob", "kind": "operand", "role": "test", "op": "rangeAgeDobOp", "value": "rangeAgeDobValue"},
        {"key": "rangeAgeAt", "kind": "operand", "role": "test", "op": "rangeAgeAtOp", "value": "rangeAgeAtValue"},
        {"key": "rangeAgeDays", "kind": "operand", "role": "test", "op": "rangeAgeDaysOp", "value": "rangeAgeDaysValue"},
        {"key": "rangeAgeMonths", "kind": "operand", "role": "test", "op": "rangeAgeMonthsOp", "value": "rangeAgeMonthsValue"},
        {"key": "rangeBy", "kind": "operand", "role": "test", "op": "rangeByOp", "value": "rangeByValue"}
      ],
      "branchKeys": ["rangeSoftLo", "rangeSoftHi", "rangeHardLo", "rangeHardHi", "rangeSoftBlock", "rangeHardBlock",
                     "rangeUnit", "rangeSoftText", "rangeHardText", "decimalComma", "rangeComputed",
                     "rangeReference", "rangeSex", "rangeMale", "rangeFemale", "rangeAgeDob", "rangeAgeAt",
                     "rangeAgeDays", "rangeAgeMonths", "rangeBy", "rangeDobType", "rangeDobFormat",
                     "rangeAtType", "rangeAtFormat", "rangeAxisComma",
                     "caseSensitive", "message"],
      "clientKeys": ["rangeSoftLo", "rangeSoftHi", "rangeHardLo", "rangeHardHi", "rangeSoftBlock", "rangeHardBlock",
                     "rangeUnit", "rangeSoftText", "rangeHardText", "decimalComma", "rangeComputed",
                     "rangeReference", "rangeSexOp", "rangeMale", "rangeFemale", "rangeAgeDobOp", "rangeAgeAtOp",
                     "rangeAgeDaysOp", "rangeAgeMonthsOp", "rangeByOp", "rangeDobType", "rangeDobFormat",
                     "rangeAtType", "rangeAtFormat", "rangeAxisComma",
                     "when", "whenAst", "caseSensitive", "message", "deferred", "deferredWhy", "snapshotFields",
                     "deferredOnSave", "extendedAdvisory"],
      "needs": [],
      "dialog": false,
      "js": {"factories": {"range": "QRIDRangeInit"}},
      "scan": {"issueLabels": {"soft-low": "Unusual value", "soft-high": "Unusual value",
                               "hard-low": "Implausible value", "hard-high": "Implausible value",
                               "not-a-number": "Not a number", "not-positive": "Not a positive measurement",
                               "*": "Implausible value"},
               "detailKeys": ["rangeSoftText", "rangeHardText"]}
    }
  ]
}
