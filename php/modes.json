      "branchKeys": ["assert", "caseSensitive", "exact", "message", "references", "i18n"],
      "clientKeys": ["assert", "assertAst", "caseSensitive", "exact", "message", "deferred", "deferredWhy", "snapshotFields", "i18n"],
      "textKeys": ["message"],
      "needs": [],
      "dialog": true,
      "js": {"factories": {"constraint": "QRIDConstraintInit"}},
      "scan": {"issueLabels": {"*": "Wrong value"}}
    },
    {
