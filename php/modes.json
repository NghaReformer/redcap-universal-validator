      "defaultType": "single",
      "parser": "parseValue",
      "checker": null,
      "hasAlgorithm": true,
      "eligibility": {
        "fieldTypes": ["text", "notes"],
        "annotationWhy": "this tag only works on Text or Notes fields (this field is \"{type}\").",
        "dialogWhy": "only Text and Notes fields can be validated"
      },
      "hooks": {},
      "evaluator": "findingsCheck",
      "missingCodes": "skip",
      "refKeys": [],
      "branchKeys": ["algorithm", "idPattern", "alternates", "source", "strip", "keepChars",
                     "idLengths", "idMinLen", "idMaxLen", "expectedIds",
                     "blockSave", "suggestFix", "note"],
      "clientKeys": ["algorithm", "idPattern", "alternates", "source", "strip", "suggestFix",
                     "keepChars", "idLengths", "idMinLen", "idMaxLen", "expectedIds",
                     "blockSave", "when", "whenAst"],
      "needs": [],
      "dialog": true,
      "js": {"factories": {"single": "QRIDSingleInit", "pooled": "QRIDPooledInit"}},
      "scan": {"issueLabels": {"*": "Wrong value"}}
    },
    {
      "mode": "constraint",
