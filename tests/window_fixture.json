{
  "_comment": [
    "The @UVWINDOW verdict contract. tests/window_php.php runs every case through",
    "TemporalLogic::windowVerdict and tests/window_js.cjs through QRID_windowVerdict; both must",
    "return exactly verdict/earliest/latest. Defaults per case: spec.unit days, valueFormat and",
    "anchorFormat ymd, clock = the top-level clock. anchor null = the rule has no anchor."
  ],
  "clock": {"today": "2026-10-09", "now": "2026-10-09 14:30:00"},
  "cases": [
    {"name": "inside the window",            "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "2026-01-22", "anchor": "2026-01-01", "verdict": "ok",           "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "one day early",                "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "2026-01-21", "anchor": "2026-01-01", "verdict": "window-early", "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "last day is inside",           "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "2026-02-05", "anchor": "2026-01-01", "verdict": "ok",           "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "one day late",                 "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "2026-02-06", "anchor": "2026-01-01", "verdict": "window-late",  "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "leap day",                     "spec": {"lo": 1, "hi": 1, "type": "date", "fromType": "date"},   "value": "2024-02-29", "anchor": "2024-02-28", "verdict": "ok",           "earliest": "2024-02-29", "latest": "2024-02-29"},
    {"name": "day after leap day is late",   "spec": {"lo": 1, "hi": 1, "type": "date", "fromType": "date"},   "value": "2024-03-01", "anchor": "2024-02-28", "verdict": "window-late",  "earliest": "2024-02-29", "latest": "2024-02-29"},
    {"name": "no leap day in 2025",          "spec": {"lo": 1, "hi": 1, "type": "date", "fromType": "date"},   "value": "2025-03-01", "anchor": "2025-02-28", "verdict": "ok",           "earliest": "2025-03-01", "latest": "2025-03-01"},
    {"name": "across the year boundary",     "spec": {"lo": 0, "hi": 10, "type": "date", "fromType": "date"},  "value": "2026-01-04", "anchor": "2025-12-25", "verdict": "ok",           "earliest": "2025-12-25", "latest": "2026-01-04"},
    {"name": "late across the year boundary","spec": {"lo": 0, "hi": 10, "type": "date", "fromType": "date"},  "value": "2026-01-05", "anchor": "2025-12-25", "verdict": "window-late",  "earliest": "2025-12-25", "latest": "2026-01-04"},
    {"name": "dmy value, saved anchor",      "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "22-01-2026", "valueFormat": "dmy", "anchor": "2026-01-01", "verdict": "ok", "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "mdy value and anchor",         "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "01-21-2026", "valueFormat": "mdy", "anchor": "01-01-2026", "anchorFormat": "mdy", "verdict": "window-early", "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "slashes are accepted",         "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "22/01/2026", "valueFormat": "dmy", "anchor": "2026/01/01", "verdict": "ok", "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "partly typed",                 "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "2026-01-2",  "anchor": "2026-01-01", "verdict": "unknown",      "earliest": null, "latest": null},
    {"name": "31 February",                  "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "31-02-2026", "valueFormat": "dmy", "anchor": "2026-01-01", "verdict": "unknown", "earliest": null, "latest": null},
    {"name": "year zero",                    "spec": {"lo": 0, "hi": null, "type": "date", "fromType": "date"}, "value": "0000-01-01", "anchor": "2026-01-01", "verdict": "unknown",     "earliest": null, "latest": null},
    {"name": "blank value",                  "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "",           "anchor": "2026-01-01", "verdict": "inert",        "earliest": null, "latest": null},
    {"name": "whitespace value",             "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": " \t ",       "anchor": "2026-01-01", "verdict": "inert",        "earliest": null, "latest": null},
    {"name": "surrounding spaces trimmed",   "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": " 2026-01-22\n", "anchor": "2026-01-01", "verdict": "ok",         "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "blank anchor switches the window off", "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "2030-01-01", "anchor": "", "verdict": "inert", "earliest": null, "latest": null},
    {"name": "blank anchor, notFuture still checked", "spec": {"lo": 21, "hi": 35, "notFuture": true, "type": "date", "fromType": "date"}, "value": "2026-01-01", "anchor": " ", "verdict": "ok", "earliest": null, "latest": null},
    {"name": "blank anchor, future still flagged", "spec": {"lo": 21, "hi": 35, "notFuture": true, "type": "date", "fromType": "date"}, "value": "2030-01-01", "anchor": "", "verdict": "future", "earliest": null, "latest": null},
    {"name": "no window, no notFuture",      "spec": {"type": "date"}, "value": "2030-01-01", "anchor": null, "verdict": "inert", "earliest": null, "latest": null},
    {"name": "unreadable anchor",            "spec": {"lo": 21, "hi": 35, "type": "date", "fromType": "date"}, "value": "2026-01-22", "anchor": "2026-13-01", "verdict": "unknown",      "earliest": null, "latest": null},
    {"name": "weeks",                        "spec": {"lo": 3, "hi": 5, "unit": "weeks", "type": "date", "fromType": "date"}, "value": "2026-01-22", "anchor": "2026-01-01", "verdict": "ok", "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "weeks, late",                  "spec": {"lo": 3, "hi": 5, "unit": "weeks", "type": "date", "fromType": "date"}, "value": "2026-02-06", "anchor": "2026-01-01", "verdict": "window-late", "earliest": "2026-01-22", "latest": "2026-02-05"},
    {"name": "negative window inside",       "spec": {"lo": -7, "hi": -1, "type": "date", "fromType": "date"}, "value": "2025-12-25", "anchor": "2026-01-01", "verdict": "ok",          "earliest": "2025-12-25", "latest": "2025-12-31"},
    {"name": "negative window early",        "spec": {"lo": -7, "hi": -1, "type": "date", "fromType": "date"}, "value": "2025-12-24", "anchor": "2026-01-01", "verdict": "window-early","earliest": "2025-12-25", "latest": "2025-12-31"},
    {"name": "negative window, same day is late", "spec": {"lo": -7, "hi": -1, "type": "date", "fromType": "date"}, "value": "2026-01-01", "anchor": "2026-01-01", "verdict": "window-late", "earliest": "2025-12-25", "latest": "2025-12-31"},
    {"name": "open start, on or before",     "spec": {"lo": null, "hi": 0, "type": "date", "fromType": "date"}, "value": "1990-05-05", "anchor": "2026-01-01", "verdict": "ok",         "earliest": null, "latest": "2026-01-01"},
    {"name": "open start, after",            "spec": {"lo": null, "hi": 0, "type": "date", "fromType": "date"}, "value": "2026-01-02", "anchor": "2026-01-01", "verdict": "window-late","earliest": null, "latest": "2026-01-01"},
    {"name": "open end, not before anchor",  "spec": {"lo": 0, "hi": null, "type": "date", "fromType": "date"}, "value": "2025-12-31", "anchor": "2026-01-01", "verdict": "window-early","earliest": "2026-01-01", "latest": null},
    {"name": "datetime hours inside",        "spec": {"lo": 0, "hi": 24, "unit": "hours", "type": "datetime", "fromType": "datetime"}, "value": "2026-01-02 08:00", "anchor": "2026-01-01 08:00", "verdict": "ok", "earliest": "2026-01-01 08:00:00", "latest": "2026-01-02 08:00:00"},
    {"name": "datetime one minute late",     "spec": {"lo": 0, "hi": 24, "unit": "hours", "type": "datetime", "fromType": "datetime"}, "value": "2026-01-02 08:01", "anchor": "2026-01-01 08:00", "verdict": "window-late", "earliest": "2026-01-01 08:00:00", "latest": "2026-01-02 08:00:00"},
    {"name": "datetime in days",             "spec": {"lo": 1, "hi": 2, "type": "datetime", "fromType": "datetime"}, "value": "2026-01-03 07:59", "anchor": "2026-01-01 08:00", "verdict": "ok", "earliest": "2026-01-02 08:00:00", "latest": "2026-01-03 08:00:00"},
    {"name": "minutes field, seconds anchor: the anchor is read to the minute", "spec": {"lo": 0, "hi": 6, "unit": "hours", "type": "datetime", "fromType": "datetime_seconds"}, "value": "2026-03-01 08:00", "anchor": "2026-03-01 08:00:30", "verdict": "ok", "earliest": "2026-03-01 08:00:00", "latest": "2026-03-01 14:00:00"},
    {"name": "minutes field, seconds anchor: the last minute is inside", "spec": {"lo": 0, "hi": 6, "unit": "hours", "type": "datetime", "fromType": "datetime_seconds"}, "value": "2026-03-01 14:00", "anchor": "2026-03-01 08:00:59", "verdict": "ok", "earliest": "2026-03-01 08:00:00", "latest": "2026-03-01 14:00:00"},
    {"name": "minutes field, seconds anchor: one minute late", "spec": {"lo": 0, "hi": 6, "unit": "hours", "type": "datetime", "fromType": "datetime_seconds"}, "value": "2026-03-01 14:01", "anchor": "2026-03-01 08:00:30", "verdict": "window-late", "earliest": "2026-03-01 08:00:00", "latest": "2026-03-01 14:00:00"},
    {"name": "minutes field, seconds anchor before 1970", "spec": {"lo": 0, "hi": 1, "unit": "minutes", "type": "datetime", "fromType": "datetime_seconds"}, "value": "1950-06-01 08:01", "anchor": "1950-06-01 08:00:45", "verdict": "ok", "earliest": "1950-06-01 08:00:00", "latest": "1950-06-01 08:01:00"},
    {"name": "seconds field, minutes anchor","spec": {"lo": 0, "hi": 1, "unit": "minutes", "type": "datetime_seconds", "fromType": "datetime"}, "value": "2026-01-01 08:01:01", "anchor": "2026-01-01 08:00", "verdict": "window-late", "earliest": "2026-01-01 08:00:00", "latest": "2026-01-01 08:01:00"},
    {"name": "dmy datetime",                 "spec": {"lo": 0, "hi": 12, "unit": "hours", "type": "datetime", "fromType": "datetime"}, "value": "02-01-2026 07:00", "valueFormat": "dmy", "anchor": "2026-01-01 20:00", "verdict": "ok", "earliest": "2026-01-01 20:00:00", "latest": "2026-01-02 08:00:00"},
    {"name": "date field, datetime anchor",  "spec": {"lo": 0, "hi": 1, "type": "date", "fromType": "datetime"}, "value": "2026-01-01", "anchor": "2026-01-01 08:00", "verdict": "unknown", "earliest": null, "latest": null},
    {"name": "date field, hours unit",       "spec": {"lo": 0, "hi": 1, "unit": "hours", "type": "date", "fromType": "date"}, "value": "2026-01-01", "anchor": "2026-01-01", "verdict": "unknown", "earliest": null, "latest": null},
    {"name": "unknown unit",                 "spec": {"lo": 0, "hi": 1, "unit": "constructor", "type": "date", "fromType": "date"}, "value": "2026-01-01", "anchor": "2026-01-01", "verdict": "unknown", "earliest": null, "latest": null},
    {"name": "not future: today",            "spec": {"notFuture": true, "type": "date"}, "value": "2026-10-09", "anchor": null, "verdict": "ok", "earliest": null, "latest": null},
    {"name": "not future: tomorrow",         "spec": {"notFuture": true, "type": "date"}, "value": "2026-10-10", "anchor": null, "verdict": "future", "earliest": null, "latest": null},
    {"name": "not future: dmy tomorrow",     "spec": {"notFuture": true, "type": "date"}, "value": "10-10-2026", "valueFormat": "dmy", "anchor": null, "verdict": "future", "earliest": null, "latest": null},
    {"name": "not future: this minute",      "spec": {"notFuture": true, "type": "datetime"}, "value": "2026-10-09 14:30", "anchor": null, "verdict": "ok", "earliest": null, "latest": null},
    {"name": "not future: next minute",      "spec": {"notFuture": true, "type": "datetime"}, "value": "2026-10-09 14:31", "anchor": null, "verdict": "future", "earliest": null, "latest": null},
    {"name": "not future: one second ahead", "spec": {"notFuture": true, "type": "datetime_seconds"}, "value": "2026-10-09 14:30:01", "anchor": null, "verdict": "future", "earliest": null, "latest": null},
    {"name": "not future before the window", "spec": {"lo": 0, "hi": 5, "notFuture": true, "type": "date", "fromType": "date"}, "value": "2026-10-20", "anchor": "2026-10-01", "verdict": "future", "earliest": "2026-10-01", "latest": "2026-10-06"},
    {"name": "not future passes, window fails", "spec": {"lo": 0, "hi": 5, "notFuture": true, "type": "date", "fromType": "date"}, "value": "2026-10-08", "anchor": "2026-10-01", "verdict": "window-late", "earliest": "2026-10-01", "latest": "2026-10-06"},
    {"name": "not future without a clock",   "spec": {"notFuture": true, "type": "date"}, "value": "2026-10-09", "anchor": null, "clock": null, "verdict": "unknown", "earliest": null, "latest": null},
    {"name": "not future with a bad clock",  "spec": {"notFuture": true, "type": "date"}, "value": "2026-10-09", "anchor": null, "clock": {"today": "09-10-2026", "now": "2026-10-09 14:30:00"}, "verdict": "unknown", "earliest": null, "latest": null},
    {"name": "bound past year 9999 is not shown", "spec": {"lo": 0, "hi": 60, "type": "date", "fromType": "date"}, "value": "9999-12-31", "anchor": "9999-12-01", "verdict": "ok", "earliest": "9999-12-01", "latest": null},
    {"name": "bound before year 1 is not shown",  "spec": {"lo": -30, "hi": 0, "type": "date", "fromType": "date"}, "value": "0001-01-01", "anchor": "0001-01-10", "verdict": "ok", "earliest": null, "latest": "0001-01-10"},
    {"name": "far window, 100 years",        "spec": {"lo": 0, "hi": 36500, "type": "date", "fromType": "date"}, "value": "2125-12-08", "anchor": "2026-01-01", "verdict": "ok", "earliest": "2026-01-01", "latest": "2125-12-08"}
  ]
}
