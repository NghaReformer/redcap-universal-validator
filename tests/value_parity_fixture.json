  "length": {
    "why": "the browser refuses a single value longer than 512 UTF-16 units before any check, after trimming; the server refuses it the same way with the reason \"too-long\"",
    "cases": [
      {
        "rule": {
          "type": "single",
          "algorithm": "none",
          "idPattern": "FC[0-9]-[0-9]{4}[0-9A-Z]"
        },
