    {
      "why": "a negated class reads a BMP character the same way in both engines; an astral character is two units to JavaScript, so it fails a one-unit class on both sides",
      "rule": {
        "type": "single",
        "algorithm": "none",
        "idPattern": "FC[^0-9][0-9]{4}",
        "strip": ""
