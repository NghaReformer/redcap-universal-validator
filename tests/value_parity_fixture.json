        ["FC1-0589C\uD83D\uDE00", "valid", "valid"]
      ]
    },
    {
      "why": "\".\" differs between the engines only for CR, U+2028 and U+2029 (JavaScript refuses them, PCRE accepts them); the server reports those as not checked; an astral character is two units to JavaScript and fails the one-unit \".\" on both sides",
      "rule": {
        "type": "single",
        "algorithm": "none",
        "idPattern": "FC.[0-9]{4}",
        "strip": ""
      },
      "rows": [
        ["FC-1234", "valid", "valid"],
        ["FC\r1234", "invalid", "not-checked"],
        ["FC\u20281234", "invalid", "not-checked"],
        ["FC\u00A01234", "valid", "valid"],
        ["FC 1234", "valid", "valid"],
        ["FC\u00E91234", "valid", "valid"],
        ["FC\uD83D\uDE001234", "invalid", "format"],
        ["FC\u30001234", "valid", "valid"],
        ["FC1234", "invalid", "format"]
      ]
    },
    {
      "why": "\"\\s\" differs only for whitespace JavaScript knows and PCRE does not (no-break space, U+2000-U+200A, U+3000 ...); the server reports those as not checked",
      "rule": {
        "type": "single",
        "algorithm": "none",
        "idPattern": "FC\\s[0-9]{4}",
        "strip": ""
      },
      "rows": [
        ["FC-1234", "invalid", "format"],
        ["FC\r1234", "valid", "valid"],
        ["FC\u20281234", "valid", "not-checked"],
        ["FC\u00A01234", "valid", "not-checked"],
        ["FC 1234", "valid", "valid"],
        ["FC\u00E91234", "invalid", "format"],
        ["FC\uD83D\uDE001234", "invalid", "format"],
        ["FC\u30001234", "valid", "not-checked"],
        ["FC1234", "invalid", "format"]
      ]
    },
    {
      "why": "\"\\S\" is the mirror image of \"\\s\"",
      "rule": {
        "type": "single",
