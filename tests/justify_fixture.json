{
  "about": "Whether a reason field's value gives a reason (@UVJUSTIFY). Logic::reasonGiven (tests/justify_php.php) and QRID_reasonGiven (tests/justify_js.cjs) read every case. A reason is text left once PHP's trim() set (space, tab, line feed, carriage return, NUL, vertical tab) is taken from both ends, and not one of the project's Missing Data Codes, compared as written. \"codes\" lists the Missing Data Codes of the case; a value given as {\"repeat\":...} is built by repeating it.",
  "cases": [
    { "name": "a word",                              "value": "fasting",            "codes": [],               "given": true },
    { "name": "a sentence with inner spaces",        "value": "clinic was closed",  "codes": [],               "given": true },
    { "name": "blank",                               "value": "",                   "codes": [],               "given": false },
    { "name": "spaces only",                         "value": "   ",                "codes": [],               "given": false },
    { "name": "tab, line feed and carriage return",  "value": "\t\n\r",             "codes": [],               "given": false },
    { "name": "NUL and vertical tab",                "value": "\u0000\u000b",       "codes": [],               "given": false },
    { "name": "a word inside the trim set",          "value": " \t ok \r\n",        "codes": [],               "given": true },
    { "name": "a form feed is not in the trim set",  "value": "\f",                 "codes": [],               "given": true },
    { "name": "a no-break space is not in the trim set", "value": " ",         "codes": [],               "given": true },
    { "name": "an ideographic space is not either",  "value": "　",             "codes": [],               "given": true },
    { "name": "a zero",                              "value": "0",                  "codes": [],               "given": true },
    { "name": "a dropdown code",                     "value": "3",                  "codes": ["UNK", "NA"],    "given": true },
    { "name": "a Missing Data Code",                 "value": "UNK",                "codes": ["UNK", "NA"],    "given": false },
    { "name": "a Missing Data Code with spaces around", "value": "  NA \n",         "codes": ["UNK", "NA"],    "given": false },
    { "name": "a code in other letter case is a reason", "value": "unk",            "codes": ["UNK"],          "given": true },
    { "name": "a code inside longer text is a reason", "value": "UNK because",      "codes": ["UNK"],          "given": true },
    { "name": "a numeric Missing Data Code",         "value": "-999",               "codes": ["-999"],         "given": false },
    { "name": "a number the codes do not hold",      "value": "-998",               "codes": ["-999"],         "given": true },
    { "name": "no codes: any text",                  "value": "UNK",                "codes": [],               "given": true },
    { "name": "a JSON number",                       "value": 7,                    "codes": [],               "given": true },
    { "name": "a JSON zero",                         "value": 0,                    "codes": [],               "given": true },
    { "name": "a JSON number that is a code",        "value": 7,                    "codes": ["7"],            "given": false },
    { "name": "a JSON fraction",                     "value": 1.5,                  "codes": [],               "given": true },
    { "name": "null",                                "value": null,                 "codes": [],               "given": false },
    { "name": "true",                                "value": true,                 "codes": [],               "given": false },
    { "name": "false",                               "value": false,                "codes": [],               "given": false },
    { "name": "a list (a checkbox's values)",        "value": ["1"],                "codes": [],               "given": false },
    { "name": "an object",                           "value": {"a": "1"},           "codes": [],               "given": false },
    { "name": "accented text",                       "value": "réduit à jeun",      "codes": [],               "given": true },
    { "name": "a long reason",                       "value": {"repeat": "why ", "times": 5000}, "codes": [], "given": true },
    { "name": "a long run of spaces",                "value": {"repeat": " ", "times": 100000},  "codes": [], "given": false },
    { "name": "a long run of spaces around a word",  "value": {"repeat": " ", "times": 50000, "suffix": "x"}, "codes": [], "given": true }
  ]
}
