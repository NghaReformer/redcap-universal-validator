                "lookup": "linear", "valid": {"min": "45", "max": "45.3"}, "adjust": "who-restricted", "scale": 10, "first": 450,
                "position": {"corrects": "axis", "standing": {"add": "0.1"}},
                "male": [[1, 2.0, 0.1], [1, 2.2, 0.1], [1, 2.4, 0.1], [1, 2.6, 0.1]],
                "female": [[1, 2.0, 0.1], [1, 2.2, 0.1], [1, 2.4, 0.1], [1, 2.6, 0.1]]}
  },
