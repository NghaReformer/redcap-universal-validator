{
  "_comment": [
    "The @UVRANGE growth-reference contract. tests/growth_php.php runs every case",
    "through php/GrowthReference.php and tests/growth_js.cjs through QRID_growth*",
    "in js/engine.js; both must return exactly what is written here. The tables",
    "are small synthetic ones in the page-copy shape (GrowthReference::pageCopy),",
    "chosen so most answers can be worked out by hand: with L 1, M 10 and S 0.1,",
    "z is (y/10 - 1)/0.1. The real WHO tables are pinned by tests/who_golden.json",
    "and the 5,000-point parity hash below."
  ],
  "references": {
    "t-days": {"title": "Test, age in days", "measure": "weight", "unit": "kg", "axis": "age", "axisUnit": "days",
               "lookup": "round", "valid": {"min": "0", "below": "10"}, "adjust": "who-restricted", "scale": 1, "first": 0,
               "male": [[1, 10, 0.1], [1, 10, 0.1], [1, 10, 0.1], [0.5, 12, 0.2], [1, 10, 0.1],
                        [1, 10, 0.1], [1, 10, 0.1], [1, 10, 0.1], [1, 10, 0.1], [1, 10, 0.1]],
               "female": [[1, 8, 0.1], [1, 8, 0.1], [1, 8, 0.1], [1, 8, 0.1], [1, 8, 0.1],
                          [1, 8, 0.1], [1, 8, 0.1], [1, 8, 0.1], [1, 8, 0.1], [1, 8, 0.1]]},
    "t-months": {"title": "Test, age in months", "measure": "weight", "unit": "kg", "axis": "age", "axisUnit": "months",
                 "lookup": "linear", "valid": {"min": "60", "below": "63"}, "adjust": "none", "scale": 1, "first": 60,
                 "male": [[1, 10, 0.1], [1, 12, 0.1], [1, 14, 0.1], [1, 16, 0.1]],
                 "female": [[1, 11, 0.1], [1, 13, 0.1], [1, 15, 0.1], [1, 17, 0.1]]},
    "t-length": {"title": "Test, by length", "measure": "weight", "unit": "kg", "axis": "length", "axisUnit": "cm",
                 "lookup": "linear", "valid": {"min": "45", "max": "45.3"}, "adjust": "who-restricted", "scale": 10, "first": 450,
                 "male": [[1, 2.0, 0.1], [1, 2.2, 0.1], [1, 2.4, 0.1], [1, 2.6, 0.1]],
                 "female": [[1, 2.0, 0.1], [1, 2.2, 0.1], [1, 2.4, 0.1], [1, 2.6, 0.1]]},
    "t-floor": {"title": "Test, half months", "measure": "weight", "unit": "kg", "axis": "age", "axisUnit": "months",
                "lookup": "floor", "valid": {"min": "24", "below": "25"}, "adjust": "none", "scale": 2, "first": 48,
                "male": [[1, 10, 0.1], [1, 20, 0.1]], "female": [[1, 10, 0.1], [1, 20, 0.1]]},
    "t-l0": {"title": "Test, L of 0", "measure": "weight", "unit": "kg", "axis": "age", "axisUnit": "days",
             "lookup": "round", "valid": {"min": "0", "below": "2"}, "adjust": "none", "scale": 1, "first": 0,
             "male": [[0, 10, 0.1], [0, 10, 0.1]], "female": [[0, 10, 0.1], [0, 10, 0.1]]}
  },
