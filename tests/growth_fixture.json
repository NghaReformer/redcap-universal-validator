    {"name": "months at the end",              "ref": "t-months", "input": {"months": "63"},               "want": {"state": "outside", "why": "the age is outside the reference (60 to under 63 months)"}},
    {"name": "months before the start",        "ref": "t-months", "input": {"months": "59.99"},            "want": {"state": "outside", "why": "the age is outside the reference (60 to under 63 months)"}},
    {"name": "a length",                       "ref": "t-length", "input": {"by": "45"},                   "want": {"state": "ok", "x": 45}},
    {"name": "the top of a max range",         "ref": "t-length", "input": {"by": "45.3"},                 "want": {"state": "ok", "x": 45.3}},
    {"name": "past the top",                   "ref": "t-length", "input": {"by": "45.31"},                "want": {"state": "outside", "why": "the length is outside the reference (45 to 45.3 cm)"}},
    {"name": "a decimal comma",                "ref": "t-length", "input": {"by": "45,1", "comma": true},  "want": {"state": "ok", "x": 45.1}},
    {"name": "a comma without the comma flag", "ref": "t-length", "input": {"by": "45,1"},                 "want": {"state": "invalid", "why": "the length is not a number"}},
    {"name": "a blank length",                 "ref": "t-length", "input": {"by": " "},                    "want": {"state": "blank", "why": "the length is blank"}}
  ],
