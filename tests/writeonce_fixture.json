{
  "_comment": [
    "Logic::writeOnceVerdict cases. saves: [ts, user, value] oldest first, value null for a save the log does not say plainly;",
    "the save's time (at) is its ts written out. roles: the users who hold a named role; rolesUnknown: the role table could",
    "not be read (holdsRole answers null). missing: the project's Missing Data Codes. since / sinceLabel: the log time the lock",
    "starts at and the date the answer names for it."
  ],
  "cases": [
    { "name": "no save and a blank value", "saves": [], "current": "", "expect": { "verdict": "ok" } },
    { "name": "no save of a value the field holds is a gap", "saves": [], "current": "A",
      "expect": { "verdict": "unknown", "why": "gap" } },
    { "name": "a code with no save checks nothing", "saves": [], "current": "NA", "missing": ["NA"], "expect": { "verdict": "ok" } },
    { "name": "one save, unchanged", "saves": [["20261001090000", "ann", "A"]], "current": "A", "expect": { "verdict": "ok" } },
    { "name": "a change by a user with no named role", "saves": [["20261001090000", "ann", "A"], ["20261005141000", "bob", "B"]],
      "current": "B", "expect": { "verdict": "changed", "lockedAt": "2026-10-01 09:00:00", "changedAt": "2026-10-05 14:10:00" } },
    { "name": "a change by a user with a named role moves the lock", "roles": ["dm"],
      "saves": [["20261001090000", "ann", "A"], ["20261005141000", "dm", "B"]], "current": "B", "expect": { "verdict": "ok" } },
    { "name": "changed and changed back", "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", "B"], ["20261003090000", "bob", "A"]],
      "current": "A", "expect": { "verdict": "ok" } },
    { "name": "a blank first save holds no lock", "saves": [["20261001090000", "ann", ""], ["20261002090000", "bob", "A"]],
      "current": "A", "expect": { "verdict": "ok" } },
    { "name": "the lock is set by the first value, and a later blank by anyone is a change",
      "saves": [["20261001090000", "ann", ""], ["20261002090000", "bob", "A"], ["20261003090000", "ann", ""]],
      "current": "", "expect": { "verdict": "cleared", "lockedAt": "2026-10-02 09:00:00", "changedAt": "2026-10-03 09:00:00" } },
    { "name": "a Missing Data Code holds no lock", "missing": ["NA"],
      "saves": [["20261001090000", "ann", "NA"], ["20261002090000", "bob", "A"]], "current": "A", "expect": { "verdict": "ok" } },
    { "name": "a code saved over the value is a change", "missing": ["NA"],
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", "NA"]], "current": "NA",
      "expect": { "verdict": "cleared", "lockedAt": "2026-10-01 09:00:00", "changedAt": "2026-10-02 09:00:00" } },
    { "name": "a blank saved by a named role releases the lock, and the next value locks again", "roles": ["dm"],
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "dm", ""], ["20261003090000", "bob", "B"]],
      "current": "B", "expect": { "verdict": "ok" } },
    { "name": "a released lock set again and then changed", "roles": ["dm"],
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "dm", ""], ["20261003090000", "bob", "B"], ["20261004090000", "bob", "C"]],
      "current": "C", "expect": { "verdict": "changed", "lockedAt": "2026-10-03 09:00:00", "changedAt": "2026-10-04 09:00:00" } },
    { "name": "a moved lock, then a change by another user", "roles": ["dm"],
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "dm", "B"], ["20261003090000", "bob", "C"]],
      "current": "C", "expect": { "verdict": "changed", "lockedAt": "2026-10-02 09:00:00", "changedAt": "2026-10-03 09:00:00" } },
    { "name": "a change, then a named role saves another value", "roles": ["dm"],
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", "B"], ["20261003090000", "dm", "C"]],
      "current": "C", "expect": { "verdict": "ok" } },
    { "name": "a change back by a named role after a change", "roles": ["dm"],
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", "B"], ["20261003090000", "dm", "A"]],
      "current": "A", "expect": { "verdict": "ok" } },
    { "name": "a save the log does not say plainly", "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", null]],
      "current": "A", "expect": { "verdict": "unknown", "why": "ambiguous" } },
    { "name": "an unclear save before the value is still unclear", "saves": [["20261001090000", "ann", null], ["20261002090000", "bob", "A"]],
      "current": "A", "expect": { "verdict": "unknown", "why": "ambiguous" } },
    { "name": "the log's last save is not the value held", "saves": [["20261001090000", "ann", "A"]], "current": "B",
      "expect": { "verdict": "unknown", "why": "gap" } },
    { "name": "the roles cannot be read for a save that departs from the lock", "rolesUnknown": true,
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", "B"]], "current": "B",
      "expect": { "verdict": "unknown", "why": "roles" } },
    { "name": "the roles are not asked when nothing departs from the lock", "rolesUnknown": true,
      "saves": [["20261001090000", "ann", ""], ["20261002090000", "bob", "A"]], "current": "A", "expect": { "verdict": "ok" } },
    { "name": "since: the value held at the date is locked from it", "since": "20261005000000", "sinceLabel": "2026-10-05",
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", "B"]], "current": "B", "expect": { "verdict": "ok" } },
    { "name": "since: a change after the date", "since": "20261005000000", "sinceLabel": "2026-10-05",
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", "B"], ["20261006090000", "bob", "C"]],
      "current": "C", "expect": { "verdict": "changed", "lockedAt": "2026-10-05", "changedAt": "2026-10-06 09:00:00" } },
    { "name": "since: a blank held at the date locks nothing", "since": "20261005000000", "sinceLabel": "2026-10-05",
      "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", ""], ["20261006090000", "bob", "C"]],
      "current": "C", "expect": { "verdict": "ok" } },
    { "name": "since: a save at the very start of the date counts after it", "since": "20261005000000", "sinceLabel": "2026-10-05",
      "saves": [["20261001090000", "ann", "A"], ["20261005000000", "bob", "B"]], "current": "B",
      "expect": { "verdict": "changed", "lockedAt": "2026-10-05", "changedAt": "2026-10-05 00:00:00" } },
    { "name": "since: an unclear value at the date", "since": "20261005000000", "sinceLabel": "2026-10-05",
      "saves": [["20261001090000", "ann", null], ["20261006090000", "bob", "C"]], "current": "C",
      "expect": { "verdict": "unknown", "why": "ambiguous" } },
    { "name": "since: an unclear save before the last one at the date does not matter", "since": "20261005000000", "sinceLabel": "2026-10-05",
      "saves": [["20261001090000", "ann", null], ["20261002090000", "ann", "A"]], "current": "A", "expect": { "verdict": "ok" } },
    { "name": "since: nothing saved before the date", "since": "20261005000000", "sinceLabel": "2026-10-05",
      "saves": [["20261006090000", "ann", "A"], ["20261007090000", "bob", "B"]], "current": "B",
      "expect": { "verdict": "changed", "lockedAt": "2026-10-06 09:00:00", "changedAt": "2026-10-07 09:00:00" } },
    { "name": "a quote the log escaped", "saves": [["20261001090000", "ann", "O\\'Brien"]], "current": "O'Brien", "expect": { "verdict": "ok" } },
    { "name": "a backslash the log escaped", "saves": [["20261001090000", "ann", "a\\\\b"]], "current": "a\\b", "expect": { "verdict": "ok" } },
    { "name": "a backslash removed after the lock (log not escaping)", "saves": [["20261001090000", "ann", "It\\'s"], ["20261002090000", "bob", "It's"]], "current": "It's",
      "expect": { "verdict": "changed", "lockedAt": "2026-10-01 09:00:00", "changedAt": "2026-10-02 09:00:00" } },
    { "name": "an escaped quote saved again as written", "saves": [["20261001090000", "ann", "O\\'Brien"], ["20261002090000", "bob", "O\\'Brien"]], "current": "O'Brien", "expect": { "verdict": "ok" } },
    { "name": "a quote the log kept as it is", "saves": [["20261001090000", "ann", "O'Brien"]], "current": "O'Brien", "expect": { "verdict": "ok" } },
    { "name": "spaces around the value", "saves": [["20261001090000", "ann", " A "]], "current": "A", "expect": { "verdict": "ok" } },
    { "name": "letter case is a change", "saves": [["20261001090000", "ann", "A"], ["20261002090000", "bob", "a"]], "current": "a",
      "expect": { "verdict": "changed", "lockedAt": "2026-10-01 09:00:00", "changedAt": "2026-10-02 09:00:00" } },
    { "name": "a number written another way is a change", "saves": [["20261001090000", "ann", "70"], ["20261002090000", "bob", "70.0"]],
      "current": "70.0", "expect": { "verdict": "changed", "lockedAt": "2026-10-01 09:00:00", "changedAt": "2026-10-02 09:00:00" } }
  ]
}
