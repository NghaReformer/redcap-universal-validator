{
  "_comment": [
    "The @UVRANGE verdict contract. tests/range_php.php runs every case through",
    "Logic::rangeVerdict and tests/range_js.cjs through QRID_rangeVerdict; both must",
    "return exactly tier/reason. Bounds are NUM_RE strings as the server stores them",
    "on the rule; a missing bound is open. decimalComma marks a *_comma_decimal field."
  ],
  "cases": [
    {"name": "inside the soft range",        "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "14",        "tier": "ok",    "reason": null},
    {"name": "soft low edge is inside",      "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "12",        "tier": "ok",    "reason": null},
    {"name": "just under the soft range",    "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "11.99",     "tier": "soft",  "reason": "soft-low"},
    {"name": "soft high edge is inside",     "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "17.5",      "tier": "ok",    "reason": null},
    {"name": "2.50 equals 2.5",              "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "17.50",     "tier": "ok",    "reason": null},
    {"name": "just over the soft range",     "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "17.51",     "tier": "soft",  "reason": "soft-high"},
    {"name": "hard low edge is soft",        "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "3",         "tier": "soft",  "reason": "soft-low"},
    {"name": "just under the hard range",    "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "2.999",     "tier": "hard",  "reason": "hard-low"},
    {"name": "hard high edge is soft",       "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "25",        "tier": "soft",  "reason": "soft-high"},
    {"name": "just over the hard range",     "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "25.0001",   "tier": "hard",  "reason": "hard-high"},
    {"name": "blank checks nothing",         "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "",          "tier": "inert", "reason": null},
    {"name": "spaces are blank",             "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "  ",        "tier": "inert", "reason": null},
    {"name": "spaces around are trimmed",    "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": " 14 ",      "tier": "ok",    "reason": null},
    {"name": "text is not a number",         "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "abc",       "tier": "hard",  "reason": "not-a-number"},
    {"name": "an exponent is not a number",  "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "1e1",       "tier": "hard",  "reason": "not-a-number"},
    {"name": "a lone minus is not a number", "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "-",         "tier": "hard",  "reason": "not-a-number"},
    {"name": "a lone point is not a number", "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": ".",         "tier": "hard",  "reason": "not-a-number"},
    {"name": "a plus sign is a number",      "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "+14",       "tier": "ok",    "reason": null},
    {"name": "leading zeros",                "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "0014",      "tier": "ok",    "reason": null},
    {"name": "a point with no leading digit","spec": {"softLo": "0", "softHi": "1"},                                     "value": ".5",        "tier": "ok",    "reason": null},
    {"name": "a comma on a point field",     "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25"}, "value": "17,6",      "tier": "hard",  "reason": "not-a-number"},
    {"name": "thousands separator",          "spec": {"hardLo": "0", "hardHi": "5000"},                                  "value": "1,200",     "tier": "hard",  "reason": "not-a-number"},
    {"name": "comma decimal inside",         "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25", "decimalComma": true}, "value": "17,5", "tier": "ok",   "reason": null},
    {"name": "comma decimal over",           "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25", "decimalComma": true}, "value": "17,6", "tier": "soft", "reason": "soft-high"},
    {"name": "comma field saved with point", "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25", "decimalComma": true}, "value": "17.6", "tier": "soft", "reason": "soft-high"},
    {"name": "comma field, two commas",      "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25", "decimalComma": true}, "value": "1,2,3", "tier": "hard", "reason": "not-a-number"},
    {"name": "comma field, comma and point", "spec": {"softLo": "12", "softHi": "17.5", "hardLo": "3", "hardHi": "25", "decimalComma": true}, "value": "1.200,5", "tier": "hard", "reason": "not-a-number"},
    {"name": "negative bounds",              "spec": {"softLo": "-5", "softHi": "5"},                                    "value": "-5.0",      "tier": "ok",    "reason": null},
    {"name": "under a negative bound",       "spec": {"softLo": "-5", "softHi": "5"},                                    "value": "-5.01",     "tier": "soft",  "reason": "soft-low"},
    {"name": "minus zero is zero",           "spec": {"hardLo": "0", "hardHi": "1"},                                     "value": "-0",        "tier": "ok",    "reason": null},
    {"name": "beyond 2^53, exact",           "spec": {"hardHi": "9007199254740992"},                                     "value": "9007199254740993", "tier": "hard", "reason": "hard-high"},
    {"name": "long fraction, exact",         "spec": {"softHi": "0.1000000000000000000001"},                             "value": "0.1000000000000000000002", "tier": "soft", "reason": "soft-high"},
    {"name": "open soft low, under hard",    "spec": {"softHi": "140", "hardLo": "40", "hardHi": "250"},                  "value": "30",        "tier": "hard",  "reason": "hard-low"},
    {"name": "open soft low, inside",        "spec": {"softHi": "140", "hardLo": "40", "hardHi": "250"},                  "value": "40",        "tier": "ok",    "reason": null},
    {"name": "open soft low, over soft",     "spec": {"softHi": "140", "hardLo": "40", "hardHi": "250"},                  "value": "150",       "tier": "soft",  "reason": "soft-high"},
    {"name": "open soft low, over hard",     "spec": {"softHi": "140", "hardLo": "40", "hardHi": "250"},                  "value": "260",       "tier": "hard",  "reason": "hard-high"},
    {"name": "soft only, outside",           "spec": {"softLo": "1", "softHi": "2"},                                     "value": "100",       "tier": "soft",  "reason": "soft-high"},
    {"name": "soft only, not a number",      "spec": {"softLo": "1", "softHi": "2"},                                     "value": "n/a",       "tier": "hard",  "reason": "not-a-number"},
    {"name": "hard only, inside",            "spec": {"hardLo": "0", "hardHi": "10"},                                    "value": "5",         "tier": "ok",    "reason": null},
    {"name": "hard only, outside",           "spec": {"hardLo": "0", "hardHi": "10"},                                    "value": "11",        "tier": "hard",  "reason": "hard-high"},
    {"name": "hard low only",                "spec": {"hardLo": "0"},                                                     "value": "-1",        "tier": "hard",  "reason": "hard-low"}
  ]
}
